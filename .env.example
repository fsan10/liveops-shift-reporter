# Local app settings. Keep this file safe to share; put real credentials in .env or the UI.
APP_HOST=127.0.0.1
APP_PORT=8765
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///var/liveops.sqlite3
ARTIFACT_DIR=var/artifacts

# Test: auto-discover/start this Cloak Login profile through the local MCP server.
# Production: set BROWSER_MODE=native and configure the persistent profile directory below.
BROWSER_MODE=cloak_cdp
CLOAK_PROFILE_ID=
CLOAK_PROFILE_NAME=
CLOAK_MCP_URL=http://127.0.0.1:19610/mcp
NATIVE_CHROMIUM_PATH=
NATIVE_USER_DATA_DIR=var/native-browser-profile
NATIVE_CONTEXT_OPTIONS={"locale":"zh-CN","timezone_id":"Asia/Shanghai","viewport":{"width":1920,"height":1080},"device_scale_factor":1}

# The current room is discovered from the realtime Compass list at collection time.
DEFAULT_SHOP_NAME=
DEFAULT_LIVE_ROOM_ID=
DEFAULT_QIANCHUAN_ACCOUNT_ID=

# Optional HTTP Basic authentication for non-loopback deployments.
ADMIN_USERNAME=
ADMIN_PASSWORD=
